# Coach Abood Client Tracker — environment template.
# Copy this file to ".env" and fill in the value, or just run ./setup.sh which
# will create .env for you. The real .env is gitignored; this .example is safe
# to commit.

# The Google Sheets ID of the coach's MASTER spreadsheet (Payments + admin
# tabs). Copy it from the master sheet's URL:
#   https://docs.google.com/spreadsheets/d/<THIS-IS-THE-ID>/edit
MASTER_SHEET_ID=your_master_spreadsheet_id_here

# --- One-click client generation (optional) -------------------------------
# Deploy apps_script/Code.gs as a Web App (see docs/CLIENT_GENERATION.md) and
# paste its /exec URL + the same secret here. When set, the New-Client wizard
# generates the client sheet and registers it automatically. Leave blank to
# fall back to the manual "Coach Tools → Generate Client Template" flow.
TEMPLATE_WEBAPP_URL=
TEMPLATE_WEBAPP_SECRET=
